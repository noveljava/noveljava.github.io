---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedReviews, type Review } from '../../lib/reviews';

export async function getStaticPaths() {
  const reviews = await getPublishedReviews();
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review } }));
}

interface Props { review: Review }
const { review } = Astro.props;
const { Content } = await render(review);
const { data } = review;
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="review-detail">
    <header>
      <a class="back-link" href="/reviews/">← 책 리뷰</a>
      <p class="kicker">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      <dl class="review-facts">
        <div><dt>책</dt><dd>{data.bookTitle}</dd></div>
        <div><dt>저자</dt><dd>{data.author}</dd></div>
        {data.finishedAt && <div><dt>완독</dt><dd>{formatDate(data.finishedAt)}</dd></div>}
        {data.rating && <div><dt>평점</dt><dd>★ {data.rating.toFixed(1)} / 5</dd></div>}
      </dl>
    </header>
    <div class="prose"><Content /></div>
    {data.tags.length > 0 && <footer class="tag-list">{data.tags.map((tag) => <span>#{tag}</span>)}</footer>}
  </article>
</BaseLayout>
