---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getPublishedReviews } from '../lib/reviews';

const reviews = await getPublishedReviews();
const recentReviews = reviews.slice(0, 3);
const developmentReviews = reviews.filter(({ data }) => data.shelf === 'development');
const generalReviews = reviews.filter(({ data }) => data.shelf === 'general');
const categories = [...new Set(reviews.map(({ data }) => data.category))];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">CODE, BOOKS &amp; LIFE</p>
      <h1>코드와 삶 사이,<br /><em>읽고 적용한 기록</em></h1>
      <p class="hero-description">
        개발서는 코드와 프로젝트에 적용한 경험까지, 그 밖의 책은 오래 남은 문장과
        생각을 기록합니다. 서로 다른 독서가 한 사람의 서재에서 만납니다.
      </p>
      <a class="primary-link" href="/reviews/">모든 책 리뷰 보기 <span>→</span></a>
    </div>
    <div class="shelf-scene" aria-label="현재 서재 통계">
      <div class="sun"></div>
      <div class="shelf-books" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <dl>
        <div><dt>개발 서재</dt><dd>{developmentReviews.length}</dd></div>
        <div><dt>일반 서재</dt><dd>{generalReviews.length}</dd></div>
      </dl>
    </div>
  </section>

  <section class="shelf-directory" aria-labelledby="shelf-directory-title">
    <div class="section-heading">
      <div><p class="kicker">TWO SHELVES</p><h2 id="shelf-directory-title">두 개의 서재</h2></div>
      <p>{reviews.length}권 · {categories.length}개 분야</p>
    </div>
    <div class="shelf-links">
      <a class="shelf-link development" href="/reviews/#development">
        <span class="shelf-number">01</span>
        <div><p>DEVELOPMENT</p><h3>개발 서재</h3><span>읽고, 실험하고, 코드에 적용한 기록</span></div>
        <strong>{developmentReviews.length}권 →</strong>
      </a>
      <a class="shelf-link general" href="/reviews/#general">
        <span class="shelf-number">02</span>
        <div><p>GENERAL</p><h3>일반 서재</h3><span>이야기와 삶에서 오래 남은 생각</span></div>
        <strong>{generalReviews.length}권 →</strong>
      </a>
    </div>
  </section>

  <section class="content-section">
    <div class="section-heading">
      <div><p class="kicker">RECENT REVIEWS</p><h2>최근에 남긴 기록</h2></div>
      {reviews.length > 3 && <a href="/reviews/">전체 보기 →</a>}
    </div>
    {recentReviews.length > 0 ? (
      <div class="review-grid">{recentReviews.map((review) => <ReviewCard review={review} />)}</div>
    ) : (
      <div class="empty-state">
        <span aria-hidden="true">첫 장</span>
        <h2>첫 번째 리뷰를 기다리고 있습니다.</h2>
        <p>읽고 난 뒤에도 마음에 머무는 책부터 천천히 기록해 보세요.</p>
      </div>
    )}
  </section>

  <section class="principles">
    <p class="kicker">HOW I READ</p>
    <h2>책을 읽고 연결하는 세 가지</h2>
    <ol>
      <li><span>01</span><strong>왜 읽었는지</strong><p>책을 펼치게 된 질문과 기대를 남깁니다.</p></li>
      <li><span>02</span><strong>어디에 적용했는지</strong><p>개발서는 코드와 프로젝트에서 직접 확인한 내용을 더합니다.</p></li>
      <li><span>03</span><strong>무엇이 남았는지</strong><p>일과 삶에 오래 남을 문장과 생각을 고릅니다.</p></li>
    </ol>
  </section>
</BaseLayout>
