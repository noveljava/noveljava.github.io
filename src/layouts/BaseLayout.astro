---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Novel Java의 서재',
  description = '읽은 책에서 오래 남기고 싶은 생각을 기록합니다.',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/og.png', Astro.site);
const pageTitle = title === 'Novel Java의 서재' ? title : `${title} · Novel Java의 서재`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Novel Java의 서재 — 읽고, 생각하고, 남깁니다" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageURL} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Novel Java의 서재 홈">
        <span class="brand-mark" aria-hidden="true">NJ</span>
        <span>
          <strong>Novel Java의 서재</strong>
          <small>읽고, 생각하고, 남깁니다</small>
        </span>
      </a>
      <nav aria-label="주요 메뉴">
        <a href="/reviews/">책 리뷰</a>
        <a href="/about/">이 서재에 관하여</a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>책장을 넘기며 발견한 생각을 천천히 기록합니다.</p>
      <p>© {new Date().getFullYear()} Novel Java</p>
    </footer>
  </body>
</html>
